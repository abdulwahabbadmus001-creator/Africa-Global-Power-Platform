APP_NAME="Africa & Global Power API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
PUBLIC_SITE_URL=http://localhost:5173
CONTACT_RECIPIENT_EMAIL=your-contact-inbox@example.com

OTP_LENGTH=8
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

EDITOR_SESSION_MINUTES=60
EDITORIAL_CHALLENGE_MINUTES=10
MFA_SECRET_KEY=replace-with-a-dedicated-random-secret
MFA_ISSUER="Africa & Global Power"
RECOVERY_CODE_COUNT=10

TRUST_LOG_SECRET=replace-with-a-dedicated-random-secret
TRUST_STATEMENT_VERSION=2026-10-05
MAX_MANUSCRIPT_MB=25

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=private_uploads
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# Local/paid-host SMTP mode:
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login
SMTP_PASSWORD=your-smtp-key
SMTP_USE_TLS=true

# Render Free-compatible Brevo HTTPS API mode:
BREVO_API_KEY=your-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME="Africa & Global Power"
